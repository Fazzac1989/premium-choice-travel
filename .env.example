# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL (used for quote links, PDF logo, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (quote links, enquiry notifications) — resend.com, free tier.
# Without a key, everything still works; emails are skipped and you share quote
# links by copying them from the admin.
RESEND_API_KEY=
# Verified sender. For testing you can use: Premium Choice Travel <onboarding@resend.dev>
RESEND_FROM=
# Where internal "new enquiry" notifications go (optional)
ENQUIRY_NOTIFY_EMAIL=info@premiumchoicetravel.com

# Admin seed credentials — used once by `npm run seed` to create the admin login.
# Set these in .env.local only; never commit real credentials.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Anti-spam on the public forms (lib/spam-guard.ts).
# Cloudflare Turnstile is free: create a widget at dash.cloudflare.com > Turnstile,
# list every brand hostname on it, and paste both keys here and into Vercel.
# Until the secret is set the challenge is skipped and the other checks carry it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the "form was opened at" stamp. Optional: falls back to the service-role key.
FORM_STAMP_SECRET=

# Hotelbeds APItude — live hotel prices for Staycations (see docs/hotelbeds.md)
# The Hotels API key and its secret from https://developer.hotelbeds.com dashboard.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
# test (default, 50 requests/day demo data) or live (after certification)
HOTELBEDS_ENV=test
# Margin on Hotelbeds' net rate when the account returns no selling rate. Default 12.
HOTELBEDS_MARKUP_PERCENT=12
# Pin the rates provider: hotelbeds | liteapi | sample. Blank = first configured.
RATES_PROVIDER=
