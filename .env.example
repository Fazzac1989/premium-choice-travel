# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL (used for quote links, PDF logo, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (quote links, enquiry notifications) — resend.com, free tier.
# Without a key, everything still works; emails are skipped and you share quote
# links by copying them from the admin.
RESEND_API_KEY=
# Verified sender. For testing you can use: Premium Choice Travel <onboarding@resend.dev>
RESEND_FROM=
# Where internal "new enquiry" notifications go (optional)
ENQUIRY_NOTIFY_EMAIL=info@premiumchoicetravel.com

# Admin seed credentials — used once by `npm run seed` to create the admin login.
# Set these in .env.local only; never commit real credentials.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Anti-spam on the public forms (lib/spam-guard.ts).
# Cloudflare Turnstile is free: create a widget at dash.cloudflare.com > Turnstile,
# list every brand hostname on it, and paste both keys here and into Vercel.
# Until the secret is set the challenge is skipped and the other checks carry it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the "form was opened at" stamp. Optional: falls back to the service-role key.
FORM_STAMP_SECRET=

# Premium Choice trade platform: every Staycations price and booking (founder, 2026-10-02).
# The address of the platform API and the Staycations key issued on the console's Brands page.
PLATFORM_API_URL=
PLATFORM_API_KEY=
# Pin the rates provider by name (platform). Blank = first configured.
RATES_PROVIDER=
# Currency customers see; other supplier currencies are converted. Default AED.
RATES_CURRENCY=AED

# Payment gateway — none is configured. Mamo Pay is expected to fill this
# in; see docs/payments.md for what a provider needs.

# ── Testing the live flows safely ───────────────────────────────────────
# With this set, EVERY email this app sends goes here instead of to the
# person it was addressed to. The subject names the real addressee and the
# body carries a banner, and each redirect is logged. It is for walking an
# enquiry end to end without writing to a customer.
#
# It does NOT catch the sign-in link: that email comes from Supabase, not
# from this app. Use a test address whose inbox you actually hold — Gmail
# plus-addressing works, e.g. you+pct-test@gmail.com — so the magic link
# reaches you.
#
# NEVER leave this set in production. It would silently stop every customer
# email and nothing on the site would look wrong. See docs/testing-emails.md
EMAIL_REDIRECT_TO=
